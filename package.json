{
  "name": "ts-monorepo-starter",
  "version": "0.1.0",
  "private": true,
  "description": "A modern TypeScript monorepo starter with Fastify API and React web app",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^16.1.5",
    "prettier": "^3.3.3",
    "turbo": "^2.0.9",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "typescript",
    "monorepo",
    "turborepo",
    "fastify",
    "react",
    "vite",
    "apollo",
    "graphql",
    "drizzle",
    "better-auth"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT"
}
